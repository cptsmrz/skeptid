# SKEPTID Environment Configuration Template
# Copy this file to .env and populate your vendor API keys.
# .env is ignored by git and must never be committed.

# External LLM Vendor Router Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
CF_API_TOKEN=""
CF_ACCOUNT_ID=""

# Vendor Model Name Overrides (optional; defaults shown)
# GEMINI_MODEL="gemini-3.8-flash"
# GROQ_MODEL="qwen/qwen3.8-27b"
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
# CF_MODEL="@cf/meta/llama-3.1-8b-instruct"

# Runtime mode: mock (default, no network required) or live (requires API keys above)
# SKEPTID_MODE="mock"
